# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8010
API_CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# Auth (single shared token for now; multi-tenant API keys come in a later phase)
AIDETECT_INTERNAL_TOKEN=dev-token-change-me

# Co.Actor read-only DB (for ground-truth scripts; never used at API runtime)
# Copy DATABASE_URL value from /Users/isalmova/Projects/Co.actor-worktree/backend/.env
COACTOR_DATABASE_URL=

# Redis (optional — if empty or unreachable, in-memory fallback is used)
REDIS_URL=redis://localhost:6380/0

# OpenRouter (LLM judge)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_JUDGE_MODEL_FAST=anthropic/claude-haiku-4-5
LLM_JUDGE_MODEL_BALANCED=anthropic/claude-haiku-4-5
LLM_JUDGE_MODEL_THOROUGH=anthropic/claude-sonnet-4-6
LLM_JUDGE_TIMEOUT_SEC=20

# Detection limits
MAX_TEXT_LENGTH=100000
DEFAULT_MODE=balanced

# Aggregator weights (overridden by models/aggregator_v1.json once calibrated)
AGG_WEIGHT_STATISTICAL=0.25
AGG_WEIGHT_PATTERNS=0.35
AGG_WEIGHT_LLM_JUDGE=0.40

# Rubric/model versions
RUBRIC_VERSION=v1
MODEL_VERSION=aidetect-0.1.0

# Cache TTLs (seconds)
CACHE_TTL_RESULT=604800
CACHE_TTL_IDEMPOTENCY=86400

# Storage paths (relative to backend/)
DATA_DIR=data
FEEDBACK_LOG_PATH=data/feedback.jsonl

# ── Observability — Langfuse (optional) ─────────────────────────────
# Open-source LLM observability. When enabled, every /v1/detections and
# /v1/rewrite call is recorded as a trace with per-LLM-call usage, cost
# and latency. Free tier on cloud.langfuse.com gives 50K events/month.
#
# To enable:
#   1. Sign up on https://cloud.langfuse.com
#   2. Create a project, generate API keys (Settings → API Keys)
#   3. Fill LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY below
#   4. Set LANGFUSE_ENABLED=1
#
# When disabled (or keys missing), all instrumentation hooks are no-op —
# the detector works exactly as before.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_RELEASE=
LANGFUSE_ENVIRONMENT=development
